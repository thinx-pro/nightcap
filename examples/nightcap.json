{
  "_comment": "Example policy. The prices are placeholders: replace them with your providers' real rates. Tool names are the MCP tool names; in Claude Code hook mode they look like mcp__<server>__<tool>, so a glob such as *generate_video matches both.",
  "budget": { "usd": 20, "per": "24h", "maxPerCall": 5 },
  "unknownTools": "allow",
  "rules": [
    {
      "tool": "*generate_video",
      "pin": { "model": ["video-draft-480p", "video-std-720p"] },
      "max": { "duration_s": 10 },
      "price": {
        "by": "model",
        "table": { "video-draft-480p": 0.02, "video-std-720p": 0.08, "video-pro-1080p": 0.5 },
        "per": "duration_s",
        "perDefault": 5
      },
      "maxCalls": 200
    },
    {
      "tool": "*generate_image",
      "price": { "by": "size", "table": { "1024": 0.04, "2048": 0.12 }, "default": 0.04 }
    },
    { "tool": "*web_search", "price": 0.005 },
    { "tool": "*send_email", "sideEffect": true, "maxCalls": 20 },
    { "tool": "*submit_form", "sideEffect": true, "maxCalls": 5 },
    { "tool": "*create_payment", "deny": true, "reason": "payments are never made by an unattended run" },
    { "tool": "Bash", "match": { "command": "curl .*api\\.example-video\\.com" }, "price": 2, "sideEffect": true }
  ]
}
